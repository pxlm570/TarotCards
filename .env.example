# Browser-safe Supabase project settings (the anon key is public by design)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_REQUIRE_INVITE=true
VITE_DEFAULT_AI_ENABLED=true
# false = hide the custom-AI entry; everyone uses the unified LLM configured
# via `npm run ai:config` (stored in Supabase app_config, never shipped to browsers)
VITE_ALLOW_CUSTOM_AI=false

# Vercel server-only settings. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Optional fallback for the shared monthly budget (CNY); the ai:config value wins
AI_MONTHLY_BUDGET_CNY=100
